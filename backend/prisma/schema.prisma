// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

enum ResumeStatus {
  UPLOADED
  TEXT_EXTRACTED
  STRUCTURED
  SCORED
  INSIGHTS_GENERATING
  INSIGHTS_GENERATED
  FAILED_EXTRACTION
  FAILED_STRUCTURE
  FAILED_SCORING
  FAILED_INSIGHTS
}

enum JobStatus {
  DRAFT
  EXTRACTING_REQUIREMENTS
  REQUIREMENTS_STRUCTURED
  ACTIVE
  FAILED_STRUCTURE
}

enum CandidateStage {
  NEW
  SHORTLISTED
  INTERVIEWING
  REJECTED
  HIRED
}

model Job {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @db.Uuid
  title                  String
  rawDescription         String    @db.Text
  structuredRequirements Json?
  lastProcessingFailure  Json?
  status                 JobStatus @default(DRAFT)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  resumes Resume[]

  @@index([userId])
}

model User {
  id                    String   @id @db.Uuid
  email                 String   @unique
  jobsCreatedCount      Int      @default(0)
  resumesCompletedCount Int      @default(0)
  resumeInFlightCount   Int      @default(0)
  createdAt             DateTime @default(now())

  jobs Job[]
}

model Resume {
  id             String       @id @default(uuid()) @db.Uuid
  jobId          String       @db.Uuid
  storagePath    String
  rawText        String?      @db.Text
  structuredData Json?
  insights       Json?
  lastProcessingFailure Json?
  status         ResumeStatus
  stage          CandidateStage @default(NEW)
  score          Float?
  scoreBreakdown Json?
  quotaReservationActive Boolean @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}
